{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "publicOrigin": {
      "type": "string",
      "pattern": "^$|^https://[^/?#\\s]+$"
    },
    "trustProxy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountKey": {
          "$ref": "#/definitions/secretRef"
        },
        "databaseUrl": {
          "$ref": "#/definitions/secretRef"
        },
        "databaseCa": {
          "$ref": "#/definitions/secretRef"
        },
        "signingKey": {
          "$ref": "#/definitions/secretRef"
        },
        "smtpPassword": {
          "$ref": "#/definitions/secretRef"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["integer", "string"]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "databaseTo": {
          "type": "array"
        },
        "smtpTo": {
          "type": "array"
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dnsTo": {
          "type": "array"
        }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9.-]{1,253}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "security": {
          "enum": ["tls", "starttls"]
        },
        "from": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}@[A-Za-z0-9.-]{3,253}$"
        },
        "user": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\r\\n]*$"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": ["sqlite", "postgresql"]
        },
        "sqlite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

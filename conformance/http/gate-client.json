              },
              {
                "kid": "test-rs",
                "alg": "RS256",
                "spki": "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAxPFRd8cny2zKsUMNdccZoGrh_EW285v_vZD7Ecg2Uhjh6pgnsHO29hTkNNK2fIXJFTQjmjbW1pcGP0HGvf_TyLW685sZLAw5OqM_57xx12MP0rhF995zeJGd-czc8HXfYuKRJuomWxdpLUa9tAEqCyvr5G-_8dgaVEvE-2YnNVXPCMX8gV_1UmNiqpdpXSrnV5q8w-S1QkzbrbgInr44mknK_Isbs_iJ6H2wUvze8BneuzSqpKDnLmGue8SnSqoTtbu6z_casJxDPKKehx-QL1xH_8EKKG9kAEgYPtQszLwxsAITZTYz_4BPoFB5cO5-Z5b5BTD43zP9vkTA78XX3wIDAQAB"
              }
            ]
          }
        }
      },
      "turnstile": {
        "method": "POST",
        "path": "/turnstile",
        "upstream": "fake",
        "upstreamPath": "/echo",
        "maxBodyBytes": 1024,
        "contentTypes": ["application/json"],
        "responseContentTypes": ["application/json"],
        "enabled": true,
        "origins": [],
        "rateLimit": null,
        "client": {
          "turnstile": {
            "header": "X-Turnstile-Token",
            "secret": "turnstile-key",
            "verifyUrl": "https://upstream.test:{port}/turnstile"
          }
        }
      },
      "honeypot": {
        "method": "POST",
        "path": "/honeypot",
        "upstream": "fake",
        "upstreamPath": "/echo",
        "maxBodyBytes": 1024,
        "contentTypes": ["application/json"],
        "responseContentTypes": ["application/json"],
        "enabled": true,
        "origins": [],
        "rateLimit": null,
        "client": {
          "honeypot": {
            "field": "website"
          }
        }
      }
    }
  },
  "policy": {
    "v": 1,
    "upstreams": {
      "upstream.test:{port}": {
        "pathPrefixes": ["/echo", "/turnstile"],
        "methods": ["GET", "POST"],
        "secrets": ["api-token", "turnstile-key"]
      }
    },
    "maxBodyBytes": 1024,
    "maxResponseBytes": 65536,
    "maxTimeoutMs": 5000,
    "limits": {
      "perIp": {
        "requests": 200,
        "windowSeconds": 60
      },
      "total": {
        "requests": 200,
        "windowSeconds": 60
      },
      "maxClients": 5000
    },
    "testing": {
      "resolve": {
        "upstream.test:{port}": "127.0.0.1"
      },
      "caFile": "{caFile}"
    }
  },
  "secrets": {
    "api-token": "TEST-ONLY-planted-secret-7f3a9c",
    "client-key": "TEST-ONLY-client-key-31b8e0",
    "turnstile-key": "TEST-ONLY-turnstile-secret-9d42"
  },

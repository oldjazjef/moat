    },
    {
      "name": "honeypot: absent",
      "request": {
        "method": "POST",
        "path": "/honeypot",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"email\":\"a@example.com\"}"
      },
      "expect": {
        "status": 200,
        "upstreamCalls": 1,
        "json": {
          "path": "/echo",
          "headers": {
            "authorization": "Bearer <SECRET>"
          }
        }
      }
    },
    {
      "name": "api key: a fourth wrong key (the third failure is above, T-71)",
      "request": {
        "method": "GET",
        "path": "/key",
        "headers": {
          "X-Api-Key": "TEST-ONLY-client-key-000001"
        },
        "body": ""
      },
      "expect": {
        "status": 401,
        "error": "client_unauthorized",
        "upstreamCalls": 0
      }
    },
    {
      "name": "api key: a fifth wrong key still answers client_unauthorized",
      "request": {
        "method": "GET",
        "path": "/key",
        "headers": {
          "X-Api-Key": "TEST-ONLY-client-key-000002"
        },
        "body": ""
      },
      "expect": {
        "status": 401,
        "error": "client_unauthorized",
        "upstreamCalls": 0
      }
    },
    {
      "name": "api key: after 5 failed attempts the right key from the same client is rate_limited, nothing forwarded (T-71, SEC-45)",
      "request": {
        "method": "GET",
        "path": "/key",
        "headers": {
          "X-Api-Key": "TEST-ONLY-client-key-31b8e0"
        },
        "body": ""
      },
      "expect": {
        "status": 429,
        "error": "rate_limited",
        "headers": {
          "retry-after": "<any>"
        },
        "upstreamCalls": 0
      }
    },
    {
      "name": "api key: X-Forwarded-For makes no new client (SEC-26)",
      "request": {
        "method": "GET",
        "path": "/key",
        "headers": {
          "X-Api-Key": "TEST-ONLY-client-key-31b8e0",
          "X-Forwarded-For": "198.51.100.9"
        },
        "body": ""
      },
      "expect": {
        "status": 429,
        "error": "rate_limited",
        "upstreamCalls": 0
      }
    },
    {
      "name": "api key: routes without an API key are not locked out",
      "request": {
        "method": "POST",
        "path": "/honeypot",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"email\":\"a@example.com\"}"
      },
      "expect": {
        "status": 200,
        "upstreamCalls": 1
      }
    }
  ]
}

{
  "description": "FR-15: origin binding and CORS. `origin` cases: a matched route, the request's Origin and Sec-Fetch-Site headers (null = absent) → `{ok: true, allowOrigin}` (null = no CORS header) or `origin_forbidden`; without Origin, a route with origins refuses `cross-site` and `same-site`. `preflight` cases: OPTIONS with Origin and Access-Control-Request-Method (and -Headers, null = absent) on a path with these routes → the answer or `preflight_rejected`. Origins compare exactly; only Content-Type may be requested; credentials are never allowed.",
  "origin": [
    {
      "name": "route without origins, no Origin header",
      "route": {
        "method": "POST",
        "origins": []
      },
      "origin": null,
      "fetchSite": null,
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    },
    {
      "name": "route without origins ignores any Origin",
      "route": {
        "method": "POST",
        "origins": []
      },
      "origin": "https://evil.example",
      "fetchSite": null,
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    },
    {
      "name": "listed origin",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://www.example.ch",
      "fetchSite": null,
      "expect": {
        "ok": true,
        "allowOrigin": "https://www.example.ch"
      }
    },
    {
      "name": "no Origin header (not a browser, or same-origin GET)",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": null,
      "fetchSite": null,
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    },
    {
      "name": "other origin",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://evil.example",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "origin differs only in case",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://WWW.example.ch",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "origin with a trailing slash",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://www.example.ch/",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "origin \"null\" (sandboxed frame, file://)",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "null",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "origin with another port",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://www.example.ch:8443",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "plain http variant",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "http://www.example.ch",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "suffix attack",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": "https://www.example.ch.evil.example",
      "fetchSite": null,
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "no Origin, but the browser says another site sent it (<img src>)",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": null,
      "fetchSite": "cross-site",
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "no Origin, sent from another subdomain of the site",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": null,
      "fetchSite": "same-site",
      "expect": {
        "ok": false,
        "error": "origin_forbidden"
      }
    },
    {
      "name": "no Origin, same origin",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": null,
      "fetchSite": "same-origin",
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    },
    {
      "name": "no Origin, typed into the address bar",
      "route": {
        "method": "POST",
        "origins": [
          "https://www.example.ch"
        ]
      },
      "origin": null,
      "fetchSite": "none",
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    },
    {
      "name": "route without origins ignores Sec-Fetch-Site",
      "route": {
        "method": "POST",
        "origins": []
      },
      "origin": null,
      "fetchSite": "cross-site",
      "expect": {
        "ok": true,
        "allowOrigin": null
      }
    }
  ],
  "preflight": [
    {
      "name": "allowed method, no headers",
      "routes": [
        {
          "method": "GET",
          "origins": [
            "https://www.example.ch"
          ]
        },
        {
          "method": "POST",
          "origins": [
            "https://www.example.ch"
          ]
        },
        {
          "method": "DELETE",
          "origins": [
            "https://admin.example.ch"
          ]
        }
      ],
      "origin": "https://www.example.ch",
      "requestMethod": "POST",
      "requestHeaders": null,
      "expect": {
        "ok": true,
        "allowOrigin": "https://www.example.ch",
        "allowMethods": [
          "GET",
          "POST"
        ],
        "allowHeaders": [
          "Content-Type"
        ],
        "maxAge": 600
      }
    },
    {
      "name": "allowed method with Content-Type",

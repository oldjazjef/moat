{
  "description": "SEC-42: the raw request path (as sent, before any decoding, without the query) → the normalised path routes are matched against exactly, or `path_invalid`. Only escapes of unreserved characters are decoded; no empty, \".\" or \"..\" segments.",
  "cases": [
    {
      "name": "root",
      "input": "/",
      "expect": {
        "ok": true,
        "path": "/"
      }
    },
    {
      "name": "plain",
      "input": "/newsletter",
      "expect": {
        "ok": true,
        "path": "/newsletter"
      }
    },
    {
      "name": "two segments",
      "input": "/api/contact",
      "expect": {
        "ok": true,
        "path": "/api/contact"
      }
    },
    {
      "name": "trailing slash is kept (and matches no route without it)",
      "input": "/newsletter/",
      "expect": {
        "ok": true,
        "path": "/newsletter/"
      }
    },
    {
      "name": "unreserved escape is decoded",
      "input": "/%41bc",
      "expect": {
        "ok": true,
        "path": "/Abc"
      }
    },
    {
      "name": "lower-case hex escape",
      "input": "/%7euser",
      "expect": {
        "ok": true,
        "path": "/~user"
      }
    },
    {
      "name": "all unreserved characters",
      "input": "/a-b_c.d~e",
      "expect": {
        "ok": true,
        "path": "/a-b_c.d~e"
      }
    },
    {
      "name": "sub-delims and colon/at",
      "input": "/a:b@c;d=e!f$g&h'i(j)k*l+m,n",
      "expect": {
        "ok": true,
        "path": "/a:b@c;d=e!f$g&h'i(j)k*l+m,n"
      }
    },
    {
      "name": "empty",
      "input": "",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "relative",
      "input": "newsletter",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "double slash",
      "input": "//",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "empty segment",
      "input": "/a//b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "dot segment",
      "input": "/./a",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "dot-dot at the end",
      "input": "/a/..",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "dot-dot in the middle",
      "input": "/a/../b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded dot-dot",
      "input": "/%2e%2e/a",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded slash",
      "input": "/a%2Fb",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded slash, lower case",
      "input": "/a%2fb",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded backslash",
      "input": "/a%5Cb",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "backslash",
      "input": "/a\\b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded null byte",
      "input": "/a%00",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "null byte",
      "input": "/a\u0000",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded percent (double encoding)",
      "input": "/a%252e",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "space",
      "input": "/a b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded space",
      "input": "/a%20b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "non-ascii",
      "input": "/ä",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "encoded utf-8",
      "input": "/%C3%A4",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "query character",
      "input": "/a?b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "fragment character",
      "input": "/a#b",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "broken escape",
      "input": "/a%zz",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "truncated escape",
      "input": "/a%4",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "CRLF",
      "input": "/a\r\nX-Injected: 1",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    },
    {
      "name": "2048 bytes",
      "input": "",
      "expect": {
        "ok": true,
        "path": ""
      }
    },
    {
      "name": "2049 bytes",
      "input": "",
      "expect": {
        "ok": false,
        "error": "path_invalid"
      }
    }
  ]
}

{
  "description": "FR-13: a route's `body` fields and the bytes of a request body → `{ok: true, body}` = the canonical JSON (RFC 8785) the gate forwards, only the listed fields at every level, or `body_invalid` (400). The body is parsed as strict JSON (docs/CRYPTO.md §2: non-negative integers only, no BOM). `body` is UTF-8 text, `bodyHex` raw bytes. String lengths count Unicode code points; `format: email` is the pattern EMAIL in libs/core/src/http/body.ts; a missing optional field stays missing, null is never a valid value.",
  "cases": [
    {
      "name": "all fields",
      "fields": {
        "email": {
          "type": "string",
          "required": true,
          "format": "email",
          "maxLength": 254
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5
        },
        "plan": {
          "type": "string",
          "enum": [
            "free",
            "pro"
          ]
        },
        "age": {
          "type": "integer",
          "minimum": 16,
          "maximum": 120
        },
        "consent": {
          "type": "boolean"
        }
      },
      "body": "{\"email\":\"a@example.ch\",\"firstName\":\"Eme\",\"plan\":\"pro\",\"age\":40,\"consent\":true}",
      "expect": {
        "ok": true,
        "body": "{\"age\":40,\"consent\":true,\"email\":\"a@example.ch\",\"firstName\":\"Eme\",\"plan\":\"pro\"}"
      }
    },
    {
      "name": "only the required field",
      "fields": {
        "email": {
          "type": "string",
          "required": true,
          "format": "email",
          "maxLength": 254

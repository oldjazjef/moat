          "maximum": 120
        },
        "consent": {
          "type": "boolean"
        }
      },
      "body": "{\"email\":\"a@example.ch\"}",
      "expect": {
        "ok": true,
        "body": "{\"email\":\"a@example.ch\"}"
      }
    },
    {

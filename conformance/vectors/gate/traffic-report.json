  "parse": [
    {
      "name": "a valid report",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1798675200,\"route\":\"newsletter\",\"requests\":3,\"s2\":2,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":1},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": true,
        "report": {
          "v": 1,
          "gateId": "gateTrafficReport00000",
          "hours": [
            {
              "hour": 1798675200,
              "route": "newsletter",
              "requests": 3,
              "s2": 2,
              "s3": 0,
              "s4": 1,
              "s5": 0,
              "errors": {
                "rate_limited": 1
              },
              "msTotal": 50,
              "msMax": 40
            }
          ]
        }
      }
    },
    {
      "name": "an empty report",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[]}",
      "expect": {
        "ok": true,
        "report": {
          "v": 1,
          "gateId": "gateTrafficReport00000",
          "hours": []
        }
      }
    },
    {
      "name": "status classes that do not add up",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1798675200,\"route\":\"newsletter\",\"requests\":3,\"s2\":1,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":1},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": false,
        "code": "report_invalid"
      }
    },
    {
      "name": "more errors than requests",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1798675200,\"route\":\"newsletter\",\"requests\":3,\"s2\":2,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":4},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": false,
        "code": "report_invalid"
      }
    },
    {
      "name": "an hour not on the hour",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1798675201,\"route\":\"newsletter\",\"requests\":3,\"s2\":2,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":1},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": false,
        "code": "report_invalid"
      }
    },
    {
      "name": "an hour in the future",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1798686000,\"route\":\"newsletter\",\"requests\":3,\"s2\":2,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":1},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": false,
        "code": "report_invalid"
      }
    },
    {
      "name": "an hour older than 30 days",
      "text": "{\"v\":1,\"gateId\":\"gateTrafficReport00000\",\"hours\":[{\"hour\":1795996800,\"route\":\"newsletter\",\"requests\":3,\"s2\":2,\"s3\":0,\"s4\":1,\"s5\":0,\"errors\":{\"rate_limited\":1},\"msTotal\":50,\"msMax\":40}]}",
      "expect": {
        "ok": false,
        "code": "report_stale"
      }
    },

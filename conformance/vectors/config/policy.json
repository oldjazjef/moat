{
  "description": "The local policy (SEC-10 to SEC-14) against a valid compiled config: `{ok: true}`, `policy_violation` (the config goes beyond the policy — the bundle is rejected, SEC-11) or `policy_invalid` (the policy file itself is malformed; the gate serves nothing). Hosts are keyed as `host[:port]`; a path prefix matches the same path or a path continuing at a \"/\" boundary.",
  "cases": [
    {
      "name": "within the policy",
      "config": {
        "version": 1,
        "upstreams": {
          "hubspot": {
            "origin": "https://api.hubapi.com",
            "auth": {
              "type": "bearer",
              "secret": "hubspot-token"
            },
            "timeoutMs": 10000
          }
        },
        "routes": {
          "newsletter": {
            "method": "POST",
            "path": "/newsletter",
            "upstream": "hubspot",
            "upstreamPath": "/crm/v3/objects/contacts",
            "maxBodyBytes": 16384,
            "contentTypes": [
              "application/json"
            ],
            "responseContentTypes": [
              "application/json"
            ],
            "enabled": true
          }
        }
      },
      "policy": {
        "v": 1,
        "upstreams": {
          "api.hubapi.com": {
            "pathPrefixes": [
              "/crm/v3/objects"
            ],
            "methods": [
              "POST"
            ],
            "secrets": [
              "hubspot-token"
            ]
          }
        },
        "maxBodyBytes": 65536,
        "maxResponseBytes": 1048576,
        "maxTimeoutMs": 15000
      },
      "expect": {
        "ok": true
      }
    },

// Prisma schema of Moat's databases on SQLite (CLAUDE.md, Database; DT-03).
//
// Keep it structurally equal to ../postgresql/schema.prisma (database-schemas.spec.ts compares
// them): the same models, fields, types, keys and maps; only the generator output and the
// provider differ.
//
//  1. snake_case table/column names via @@map/@map, so the SQL reads like SQL.
//  2. No enums, no DateTime: closed values and timestamps are TEXT that the hand-written CHECK
//     constraints in the migrations keep honest (ISO-8601 UTC, `Z`).
//  3. The datasource URL is never in this file: the desktop opens the file itself
//     (persistence/database), and `prisma migrate diff` works from the schema alone.
//  4. Nothing in here may ever hold a plaintext secret, a key file or a passphrase (DT-03,
//     SEC-31): sealed secrets are the ciphertext files as they are on disk, bundles the signed
//     bytes as they are on disk.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma-sqlite"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

/// The local history of one project (`<MOAT_DATA_DIR>/history/<project id>.db`): append-only,
/// hash-chained (each row's hash covers the previous row's hash). Triggers refuse UPDATE/DELETE.
model HistoryEntry {
  /// 1, 2, 3, … without gaps; written by the API as the previous row's seq + 1.
  seq      Int    @id
  /// ISO-8601 UTC with milliseconds and `Z`.
  at       String
  /// bundle_signed | secret_sealed | deploy | config_edited | history_started | database_pushed | database_pulled
  kind     String
  /// The event's details as canonical JSON (JCS); names, versions, digests and hashes only.
  details  String
  /// The previous row's hash; 64 zeros for the first row.
  prevHash String @map("prev_hash")
  /// SHA-256 hex over the canonical JSON of {seq, at, kind, details, prev}.
  hash     String @unique

  @@map("history_entry")
}

/// A project in an external database (sync and backup target). `key` is the name it was
/// connected under; several desktops connect to the same key.
model SyncProject {
  key        String       @id
  /// moat.yaml as text (never contains a secret: config schema + lint, SEC-20).
  configText String       @map("config_text")
  /// SHA-256 hex of configText.
  configHash String       @map("config_hash")
  /// Optimistic lock for moat.yaml (DT-13): +1 on every change of configText.
  revision   Int
  updatedAt  String       @map("updated_at")
  gates      SyncGate[]
  secrets    SyncSecret[]
  bundles    SyncBundle[]

  @@map("sync_project")
}

/// gates/<name>.json: a gate's public identity (gate id and box public key).
model SyncGate {
  project String
  name    String
  text    String
  owner   SyncProject @relation(fields: [project], references: [key], onDelete: Cascade)

  @@id([project, name])
  @@map("sync_gate")
}

/// secrets/<gate>/<name>.json: a sealed secret, ciphertext only (SEC-31).
model SyncSecret {
  project       String
  gate          String
  name          String
  secretVersion Int         @map("secret_version")
  text          String
  owner         SyncProject @relation(fields: [project], references: [key], onDelete: Cascade)

  @@id([project, gate, name])
  @@map("sync_secret")
}

/// bundles/<gate>/<version>.json: a signed bundle, its exact bytes. Never replaced (a trigger
/// refuses UPDATE): the primary key is the optimistic lock of DT-13.
model SyncBundle {
  project String
  gate    String
  version Int
  /// SHA-256 hex of text.
  digest  String
  text    String
  owner   SyncProject @relation(fields: [project], references: [key], onDelete: Cascade)

  @@id([project, gate, version])
  @@map("sync_bundle")
}

// ── Moat Cloud (AUTH_MODE=cloud): accounts, sessions, organisations ──────────────────────────
// Identifiers are 22 characters of base64url (128 random bits). Nothing in these tables holds a
// password, a session token, a TOTP secret or a recovery code in the clear: only Argon2id hashes,
// SHA-256 digests of random tokens, and one AEAD-sealed TOTP secret. Passkeys (WebAuthn) and
// OIDC identities join later as further tables that point at `account`.

/// A person who can sign in to Moat Cloud.
model Account {
  id                String         @id
  /// Lower-case, trimmed; the sign-in name. Unique.
  email             String         @unique
  /// libsodium crypto_pwhash_str (Argon2id, self-describing); never returned or logged.
  passwordHash      String         @map("password_hash")
  /// A change revokes every session of the account.
  passwordChangedAt String         @map("password_changed_at")
  createdAt         String         @map("created_at")
  /// NULL = the address was not verified (a deployment without SMTP treats everyone as verified).
  emailVerifiedAt   String?        @map("email_verified_at")
  tokens            AccountToken[]
  totp              AccountTotp?
  recoveryCodes     RecoveryCode[]
  sessions          Session[]
  memberships       Membership[]

  @@map("account")
}

/// A one-time link token (verify an address, reset a password): only the SHA-256 of the token.
model AccountToken {
  /// SHA-256 hex of the 256-bit token.
  id        String  @id
  accountId String  @map("account_id")
  /// verify_email | reset_password
  purpose   String
  createdAt String  @map("created_at")
  expiresAt String  @map("expires_at")
  usedAt    String? @map("used_at")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
  @@map("account_token")
}

/// The TOTP second factor (RFC 6238). Pending until `enabled_at` is set.
model AccountTotp {
  accountId    String  @id @map("account_id")
  /// base64url(nonce ‖ XChaCha20-Poly1305 ciphertext) of the 20-byte secret, AD = account id,
  /// under the server's MOAT_ACCOUNT_KEY. Never returned after enrolment.
  sealedSecret String  @map("sealed_secret")
  /// NULL while the person has not yet confirmed a first code.
  enabledAt    String? @map("enabled_at")
  /// The last accepted 30-second step: a code is accepted once (replay).
  lastStep     Int     @map("last_step")
  createdAt    String  @map("created_at")
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_totp")
}

/// A one-time recovery code, stored as SHA-256 hex of the code (80 random bits).
model RecoveryCode {
  id        String  @id
  accountId String  @map("account_id")
  codeHash  String  @unique @map("code_hash")
  usedAt    String? @map("used_at")
  createdAt String  @map("created_at")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("recovery_code")
}

/// A browser session. `id` is SHA-256 hex of the random 256-bit cookie token: a database dump
/// cannot be turned into a session.
model Session {
  id         String  @id
  accountId  String  @map("account_id")
  createdAt  String  @map("created_at")
  lastSeenAt String  @map("last_seen_at")
  /// Absolute expiry; the idle expiry is checked against `last_seen_at`.
  expiresAt  String  @map("expires_at")
  revokedAt  String? @map("revoked_at")
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("session")
}

/// A tenant (SEC-50).
model Organisation {
  id          String       @id
  name        String
  createdAt   String       @map("created_at")
  memberships Membership[]
  projects    OrgProject[]
  invitations PendingInvitation[]

  @@map("organisation")
}

/// An account's role in an organisation (SEC-52). `release_granted` is the separate sign/release
/// permission: only Owner, Admin and Editor can hold it.
model Membership {
  organisationId String       @map("organisation_id")
  accountId      String       @map("account_id")
  /// owner | admin | editor | viewer | billing
  role           String
  releaseGranted Boolean      @map("release_granted")
  createdAt      String       @map("created_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([organisationId, accountId])
  @@index([accountId])
  @@map("membership")
}

/// An invitation to an address without a verified account; applied once, when it is verified.
model PendingInvitation {
  id             String       @id
  organisationId String       @map("organisation_id")
  /// Normalised (lower case).
  email          String
  /// owner | admin | editor | viewer | billing
  role           String
  invitedBy      String       @map("invited_by")
  createdAt      String       @map("created_at")
  expiresAt      String       @map("expires_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, email])
  @@index([email])
  @@map("pending_invitation")
}

/// A Cloud project of an organisation (not the Desktop's folder-based project).
model OrgProject {
  id             String       @id
  organisationId String       @map("organisation_id")
  name           String
  createdAt      String       @map("created_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  config         CloudConfig?
  gates          CloudGate[]

  @@index([organisationId])
  @@map("org_project")
}

/// A fixed-window counter for rate limits (login, register). `key` is a SHA-256 hex of
/// "scope:subject", so no e-mail address or IP sits in the table.
model RateLimit {
  key       String @id
  windowEnd String @map("window_end")
  count     Int

  @@map("rate_limit")
}

/// A row of an organisation's audit log (SEC-53): append-only (triggers), hash-chained per
/// organisation (libs/core audit/audit-log.ts). No relations on purpose: a cascade must not reach it.
model AuditEntry {
  organisationId String @map("organisation_id")
  /// 1, 2, 3, … without gaps per organisation; a duplicate is a lost race and is retried.
  seq            Int
  /// ISO-8601 UTC with milliseconds and `Z`.
  at             String
  /// The account that did it.
  actor          String
  /// org.create | member.add_requested | member.change | member.remove | invitation.revoke | project.create | project.delete | config.edit | gate.add | gate.remove | gate.pull_token | secret.set | bundle.sign | bundle.upload
  action         String
  target         String?
  /// The details as canonical JSON (JCS): roles, flags and digests only.
  details        String
  prevHash       String @map("prev_hash")
  /// SHA-256 hex over the canonical JSON of the row and prevHash.
  hash           String @unique

  @@id([organisationId, seq])
  @@map("audit_entry")
}

/// A Cloud project's moat.yaml (text, never a secret). `revision` is the optimistic lock.
model CloudConfig {
  projectId String     @id @map("project_id")
  text      String
  revision  Int
  updatedAt String     @map("updated_at")
  project   OrgProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("cloud_config")
}

/// A gate of a Cloud project. managed = trust mode 0 (Moat Cloud signs with its installation key);
/// signed = modes 1 to 3 (the customer's public key is pinned, the Cloud only stores and serves).
model CloudGate {
  projectId     String       @map("project_id")
  name          String
  gateId        String       @map("gate_id")
  /// X25519 public key the gate printed at install (base64url): what secrets are sealed to.
  boxKey        String       @map("box_key")
  /// managed | signed
  mode          String
  signerKid     String?      @map("signer_kid")
  signerKey     String?      @map("signer_key")
  /// SHA-256 hex of the token in the gate's pull address; the token itself is never stored.
  pullTokenHash String?      @unique @map("pull_token_hash")
  createdAt     String       @map("created_at")
  project       OrgProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets       CloudSecret[]
  bundles       CloudBundle[]

  @@id([projectId, name])
  @@map("cloud_gate")
}

/// A sealed secret (ciphertext only, SEC-31).
model CloudSecret {
  projectId     String    @map("project_id")
  gate          String
  name          String
  secretVersion Int       @map("secret_version")
  /// The sealed secret as JSON.
  text          String
  updatedAt     String    @map("updated_at")
  cloudGate     CloudGate @relation(fields: [projectId, gate], references: [projectId, name], onDelete: Cascade)

  @@id([projectId, gate, name])
  @@map("cloud_secret")
}

/// A signed bundle as signed; never replaced (SEC-04).
model CloudBundle {
  projectId String    @map("project_id")
  gate      String
  version   Int
  /// SHA-256 hex of the text.
  digest    String
  text      String
  createdAt String    @map("created_at")
  cloudGate CloudGate @relation(fields: [projectId, gate], references: [projectId, name], onDelete: Cascade)

  @@id([projectId, gate, version])
  @@map("cloud_bundle")
}

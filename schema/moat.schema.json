{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "description": "false locks every gate of this environment; default true",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "environment": {
            "description": "the environment this gate belongs to",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "enabled": {
            "description": "false locks this gate; default true",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "upstreams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "description": "HTTPS origin of the API, e.g. \"https://api.hubapi.com\""
          },
          "auth": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "bearer"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "type",
                      "secret"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "header"
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9-]{1,64}$"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "type",
                      "name",
                      "secret"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "query"
                      },
                      "param": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "type",
                      "param",
                      "secret"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "basic"
                      },
                      "username": {
                        "type": "string",
                        "pattern": "^[\\x21-\\x39\\x3B-\\x7E]{1,128}$"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "type",
                      "username",
                      "secret"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "oauth2"
                      },
                      "tokenUrl": {
                        "type": "string"
                      },
                      "clientId": {
                        "type": "string",
                        "pattern": "^[\\x21-\\x39\\x3B-\\x7E]{1,128}$"
                      },
                      "scope": {
                        "type": "string",
                        "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]{1,128}(?: [\\x21\\x23-\\x5B\\x5D-\\x7E]{1,128}){0,15}$"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "type",
                      "tokenUrl",
                      "clientId",
                      "secret"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "timeout": {
            "description": "e.g. \"10s\" (default)",
            "type": "string"
          }
        },
        "required": [
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "upstream": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "upstreamPath": {
            "type": "string"
          },
          "maxBodySize": {
            "description": "e.g. \"16KiB\"; default \"64KiB\"",
            "type": "string"
          },
          "contentTypes": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
            }
          },
          "responseContentTypes": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "origins": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rateLimit": {
            "type": "object",
            "properties": {
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "window": {
                "type": "string"
              },
              "per": {
                "type": "string",
                "enum": [
                  "ip",
                  "route"
                ]
              }
            },
            "required": [
              "requests",
              "window"
            ],
            "additionalProperties": false
          },
          "quota": {
            "type": "object",
            "properties": {
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "period": {
                "type": "string",
                "enum": [
                  "day",
                  "month"
                ]
              }
            },
            "required": [
              "requests",
              "period"
            ],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "usage": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "gemini"
                ]
              },
              "period": {
                "type": "string",
                "enum": [
                  "day",
                  "month"
                ]
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              },
              "cost": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "string"
                  },
                  "inputPerMillion": {
                    "type": "string"
                  },
                  "outputPerMillion": {
                    "type": "string"
                  }
                },
                "required": [
                  "limit",
                  "inputPerMillion",
                  "outputPerMillion"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "usage",
              "period",
              "maxOutputTokens"
            ],
            "additionalProperties": false
          },
          "body": {
            "$ref": "#/$defs/__schema0"
          },
          "client": {
            "type": "object",
            "properties": {
              "apiKey": {
                "type": "object",
                "properties": {
                  "header": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "secret": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  }
                },
                "required": [
                  "secret"
                ],
                "additionalProperties": false
              },
              "jwt": {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "pattern": "^[\\x21-\\x7E]{1,256}$"
                  },
                  "audience": {
                    "type": "string",
                    "pattern": "^[\\x21-\\x7E]{1,256}$"
                  },
                  "keys": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kid": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]{1,128}$"
                        },
                        "alg": {
                          "type": "string",
                          "enum": [
                            "EdDSA",
                            "ES256",
                            "RS256"
                          ]
                        },
                        "spki": {
                          "type": "string",
                          "maxLength": 1500
                        }
                      },
                      "required": [
                        "kid",
                        "alg",
                        "spki"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "issuer",
                  "audience",
                  "keys"
                ],
                "additionalProperties": false
              },
              "turnstile": {
                "type": "object",
                "properties": {
                  "header": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "secret": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "verifyUrl": {
                    "type": "string"
                  }
                },
                "required": [
                  "secret"
                ],
                "additionalProperties": false
              },
              "honeypot": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                  }
                },
                "required": [
                  "field"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "method",
          "path",
          "upstream",
          "upstreamPath"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "upstreams",
    "routes"
  ],
  "additionalProperties": false,
  "description": "Moat configuration (moat.yaml), version 1",
  "$defs": {
    "__schema0": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "required": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "enum": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "format": {
              "type": "string",
              "enum": [
                "email"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "required": {
              "type": "boolean"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "required": {
              "type": "boolean"
            },
            "fields": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "required": {
              "type": "boolean"
            },
            "items": {
              "$ref": "#/$defs/__schema1"
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "type",
            "items",
            "maxItems"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

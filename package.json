{
  "name": "@moat/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "volta": {
    "node": "22.23.2"
  },
  "scripts": {
    "prepare": "node scripts/dev/install-hooks.mjs && pnpm db:generate",
    "db:generate": "prisma generate --config apps/api/prisma/sqlite/prisma.config.ts && prisma generate --config apps/api/prisma/postgresql/prisma.config.ts",
    "test:integration": "vitest run --config apps/api/vitest.integration.config.ts",
    "test": "vitest run",
    "lint": "nx run-many -t lint",
    "lint:budget": "node scripts/check-lint-budget.mjs",
    "lint:yaml": "yamllint -s .",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vectors": "node scripts/regenerate.mjs vectors",
    "ci:verify": "pnpm lint && pnpm lint:budget && pnpm lint:yaml && pnpm format:check && pnpm test && pnpm build && pnpm typecheck",
    "check": "pnpm ci:verify",
    "check:gate-php": "composer --working-dir=gates/php check",
    "build:gate-php": "php gates/php/build/build.php",
    "check:all": "pnpm check && pnpm check:gate-php",
    "conformance": "vitest run --project core libs/core/src/conformance.spec.ts && composer --working-dir=gates/php conformance",
    "schema": "node scripts/regenerate.mjs schema",
    "build": "nx run-many -t build",
    "start:desktop": "nx run desktop:start",
    "moat": "node dist/apps/cli/moat.cjs"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.8.0",
    "@analogjs/vitest-angular": "~2.8.0",
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.2",
    "@angular/language-service": "~22.2.2",
    "@eslint/js": "^9.8.0",
    "@nestjs/testing": "^11.2.7",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@schematics/angular": "~22.2.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "angular-eslint": "^22.5.0",
    "electron": "42.11.10",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.3.0",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.1",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",

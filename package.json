    "@angular/compiler": "~22.2.2",
    "@angular/core": "~22.2.2",
    "@angular/forms": "~22.2.2",
    "@angular/platform-browser": "~22.2.2",
    "@angular/router": "~22.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
